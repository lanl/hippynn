# =============================================================================
# Model B (scaled NACR / dENACR, v3 head, pairs 12/13/23) training config -- ENOL, BALF pool.
# EXAMPLE bundle. NACR-only; ORACLE GDV+GAP read from disk at training (Model A supplies them at
# inference). This config reproduces the shipped decoupled Model B (models/modelB_enol_nf145/BALF).
#   n_states = 3 -> three EXCITED states (S1,S2,S3); coupling pairs 12/13/23.
# Developer: Ajay Khanna | LANL/Sergei Lab | Sep-01-2026 | ml_namd
# =============================================================================
train_energies       = false
train_forces         = false
train_tdipoles       = false
train_scaled_nacrs   = true
n_states             = 3
scaled_nacr_head     = direct_vector_v3
targeted_scaled_nacr_pairs = 12, 13, 23
direct_nacr_v2_mode  = gdv_pair_mixing_residual
gdv_source           = file
gdv_file_template    = {prefix}GDV{pair}.npy
gap_file_template    = {prefix}GAP{pair}.npy
phasesign_corrected_scaled_nacr = false   # phaseless loss path
# joint_state_nacr_loss = true            # uncomment for the sign-consistent joint per-state loss

network_type         = hiphopnn
possible_species     = 0 1 6 8
n_features           = 145
n_sensitivities      = 20
dist_soft_min        = 0.7
dist_soft_max        = 5.67638290906325
dist_hard_max        = 11.833504244685173
n_interaction_layers = 2
n_atom_layers        = 3
l_max                = 3
n_max                = 4

batch_size           = 64
eval_batch_size      = 32
max_batch_size       = 64
max_epochs           = 250
learning_rate        = 4.31e-4
l2_weight            = 2e-5
termination_patience = 50
scheduler_patience   = 16
scheduler_factor     = 0.2
fraction_train_eval  = 0.1
plot_frequency       = 50
nacr_weight          = 1.0

dataset_prefix       = acn_
n_atoms              = 15
seed                 = 114514
test_size            = 0.1
valid_size           = 0.1
data_dir             = /usr/projects/ml4chem/akhanna2/softwares/hippynn_NAMD/ml_namd/example/data/BALF
output_dir           = /usr/projects/ml4chem/akhanna2/softwares/hippynn_NAMD/ml_namd/example/runs/model_b_BALF/model
