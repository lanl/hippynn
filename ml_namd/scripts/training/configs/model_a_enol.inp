# =============================================================================
# Model A (E + F, S0-S5) training config for the ENOL tautomer.
# Self-contained per-run config for unified_training.py (per-run .inp policy: no CLI overrides).
# Derived from the param-swap "ss_base.inp" E+F bundle (nf145, the 2026-07-11 winner) + explicit
# state selection and enol dataset/output paths. Replace the paths with your own.
#   n_states = 5  ->  five EXCITED states (S1..S5); with include_ground_state = true this is S0-S5.
# Developer: Ajay Khanna | LANL/Sergei Lab | Sep-01-2026 | ml_namd
# =============================================================================

# --- properties in the loss: energies + forces only (this is what makes it Model A) ---
train_energies       = true
train_forces         = true
train_tdipoles       = false
train_scaled_nacrs   = false

# --- state selection: S0-S5 ---
n_states             = 5
include_ground_state = true

# --- network (nf145 bundle) ---
network_type         = hiphopnn
possible_species     = 0 1 6 8
n_features           = 145
n_sensitivities      = 20
dist_soft_min        = 0.7
dist_soft_max        = 5.67638290906325
dist_hard_max        = 11.833504244685173
n_interaction_layers = 2
n_atom_layers        = 3
l_max                = 3
n_max                = 4

# --- training protocol (param-swap regime: effective batch 64, no growth) ---
batch_size           = 64
eval_batch_size      = 256
max_batch_size       = 64
max_epochs           = 300
learning_rate        = 3.15e-4
l2_weight            = 6.97e-6
termination_patience = 50
scheduler_patience   = 16
scheduler_factor     = 0.2
stopping_key         = Loss
fraction_train_eval  = 0.1
plot_frequency       = 50

# --- loss weights / physics ---
energy_weight        = 1.0
force_weight         = 1.0
force_sign           = -1

# --- dataset (enol S0-dynamics, 50K) ---
dataset_prefix       = acn_
n_atoms              = 15
seed                 = 114514
test_size            = 0.1
valid_size           = 0.1
data_dir             = /users/akhanna2/data/ml_namd_project/data/enol/50K
output_dir           = /lustre/scratch5/akhanna2/ml_namd_project/experiments/enol_model_a_s0s5/model
