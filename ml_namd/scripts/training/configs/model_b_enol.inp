# =============================================================================
# Model B (scaled NACR / dENACR, v3 head, pairs 12/13/23) training config for the ENOL tautomer.
# Self-contained per-run config for unified_training.py. NACR-only, ORACLE GDV+GAP read from disk at
# training (Model A supplies them at inference). Derived from the param-swap isolated_nf145_enol.inp.
#   n_states = 3  ->  three EXCITED states (S1,S2,S3); the coupling pairs are 12/13/23.
# Developer: Ajay Khanna | LANL/Sergei Lab | Sep-01-2026 | ml_namd
# =============================================================================

# --- target: scaled NACR only, v3 GDV+gap-aware head ---
train_energies       = false
train_forces         = false
train_tdipoles       = false
train_scaled_nacrs   = true
n_states             = 3
scaled_nacr_head     = direct_vector_v3
targeted_scaled_nacr_pairs = 12, 13, 23
direct_nacr_v2_mode  = gdv_pair_mixing_residual
gdv_source           = file
gdv_file_template    = {prefix}GDV{pair}.npy
gap_file_template    = {prefix}GAP{pair}.npy
phasesign_corrected_scaled_nacr = false   # phaseless loss path (see below to switch to joint)
# joint_state_nacr_loss = true            # uncomment for the sign-consistent joint per-state loss

# --- network (nf145 bundle) ---
network_type         = hiphopnn
possible_species     = 0 1 6 8
n_features           = 145
n_sensitivities      = 20
dist_soft_min        = 0.7
dist_soft_max        = 5.67638290906325
dist_hard_max        = 11.833504244685173
n_interaction_layers = 2
n_atom_layers        = 3
l_max                = 3
n_max                = 4

# --- training ---
batch_size           = 64
eval_batch_size      = 32
max_batch_size       = 64
max_epochs           = 250
learning_rate        = 4.31e-4
l2_weight            = 2e-5
termination_patience = 50
scheduler_patience   = 16
scheduler_factor     = 0.2
fraction_train_eval  = 0.1
plot_frequency       = 50
nacr_weight          = 1.0

# --- dataset ---
# The dataset must carry acn_dENACR{ij} (targets) + acn_GDV{ij} + acn_GAP{ij} (inputs) for pairs 12/13/23.
# Primary here: the enol BALF clean-geometry S0-S3 pool. Alternative (the isolated param-swap default):
#   /lustre/scratch5/akhanna2/ml_namd_project/data_gen/pooled/enol_s0s3_400k
dataset_prefix       = acn_
n_atoms              = 15
seed                 = 114514
test_size            = 0.1
valid_size           = 0.1
data_dir             = /lustre/scratch5/akhanna2/ml_namd_project/data_gen/enol_balf_galf/BALF/pool_s0s3
output_dir           = /lustre/scratch5/akhanna2/ml_namd_project/experiments/enol_model_b_s0s3/model
